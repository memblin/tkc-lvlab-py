---
network:
  version: {{ config.network_version.value }}
  config:
    {%- for iface in config.interfaces %}
    - type: physical
      name: {{ iface.name }}
      {%- if iface.macaddress %}
      # Match the NIC by MAC (lvlab pins one per interface). Unlike v2,
      # v1's ``name`` is the in-guest device ifupdown brings up, not a
      # label: if it differs from the kernel name (Debian 11 cloud images
      # use enp1s0) cloud-init must rename the NIC, and when that rename
      # doesn't happen ``ifup <name>`` finds no device. Callers therefore
      # pass the real device name (createvm uses enp1s0 for v1 images).
      mac_address: {{ iface.macaddress }}
      {%- endif %}
      subnets:
         {%- if iface.ip4 %}
         - type: static
           address: {{ iface.ip4 }}
           gateway: {{ iface.ip4gw }}
         {%- endif %}
         {%- if iface.ip6 %}
         # static6 is cloud-init's ENI shape for a per-family IPv6 static
         # assignment alongside (or instead of) the v4 ``static`` subnet
         # above (#137).
         - type: static6
           address: {{ iface.ip6 }}
           gateway: {{ iface.ip6gw }}
         {%- endif %}
         {%- if not iface.ip4 and not iface.ip6 %}
         - type: dhcp4
         {%- endif %}
    {%- if config.nameservers.search is defined and config.nameservers.search | length > 0 %}
    - type: nameserver
      address:
        {%- for dns_server in config.nameservers.addresses %}
        - {{ dns_server }}
        {%- endfor %}
      search:
        {%- for search_domain in config.nameservers.search %}
        - {{ search_domain }}
        {%- endfor %}
    {%- endif %}
    {%- endfor %}

